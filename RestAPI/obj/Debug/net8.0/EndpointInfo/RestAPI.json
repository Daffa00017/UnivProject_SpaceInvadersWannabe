{
  "openapi": "3.0.1",
  "info": {
    "title": "RestAPI",
    "version": "v1"
  },
  "paths": {
    "/api/Scores": {
      "post": {
        "tags": [
          "Scores"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitScoreDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitScoreDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitScoreDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Scores/top": {
      "get": {
        "tags": [
          "Scores"
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Scores/player/{name}/best": {
      "get": {
        "tags": [
          "Scores"
        ],
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Scores/player/{name}/history": {
      "get": {
        "tags": [
          "Scores"
        ],
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Scores/all": {
      "get": {
        "tags": [
          "Scores"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Scores/submit": {
      "post": {
        "tags": [
          "Scores"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScoreSubmitDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ScoreSubmitDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ScoreSubmitDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ScoreSubmitDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          },
          "score": {
            "type": "integer",
            "format": "int32"
          },
          "level": {
            "type": "integer",
            "format": "int32"
          },
          "timeSec": {
            "type": "number",
            "format": "double"
          },
          "selectedShipId": {
            "type": "string",
            "nullable": true
          },
          "unlockedShips": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "lastUpdatedSec": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "SubmitScoreDto": {
        "type": "object",
        "properties": {
          "playerName": {
            "type": "string",
            "nullable": true
          },
          "score": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      }
    }
  }
}